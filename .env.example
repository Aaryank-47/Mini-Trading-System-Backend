# Environment Configuration
ENVIRONMENT=LOCAL
DEBUG=True
APP_NAME="Trading Platform API"

# Security
# Change this secret key in production!
SECRET_KEY=docker-secret-key-only-for-local-testing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=*

# Database
# For Docker development, this points to the internal Postgres service
DB_URL=postgresql://trading_user:trading_pass@postgres:5432/trading_db

# Redis
# For Docker development, this points to the internal Redis service
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
